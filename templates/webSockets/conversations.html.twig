{% extends "base.html.twig" %}

{% block header %}
    <div style="padding: 10px 20px; background: #f4c542; display: flex; gap: 15px; align-items: center;">
        <a href="{{ path("app_home") }}" style="text-decoration: none; color: #333; font-weight: bold;">🏠 Volver al Inicio</a>
        <a href="{{ path("logout") }}" style="text-decoration: none; color: #a93226; font-weight: bold;">🚪 Cerrar Sesión</a>
    </div>
{% endblock %}


{% block content %}

<h1>Conversaciones</h1>
<a href="path"><h4>Crear una nueva conversacion</h4></a>
<hr>
{% for conv in conversaciones %}
    <div>
        <a href="{{ path('viewConversationContent', {'id': conv.idConversacion}) }}">
            <h3>{{ conv.nombreConversacion }}</h3>
        </a>
    </div>
    <hr>
{% else %}
    <p>No hay conversaciones.</p>
{% endfor %}

{% endblock %}
