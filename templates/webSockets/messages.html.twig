{% extends "base.html.twig" %}

{% block content %}
<div class="chat-main-layout" style="padding: 20px; box-sizing: border-box; max-width: 800px; margin: 0 auto;">

    <div class="chat-container" style="display: flex; flex-direction: column; background: #f9f9f9; padding: 15px; border-radius: 8px; border: 1px solid #ddd; height: 80vh;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 10px;">
            <h2 style="margin: 0;">Conversación: {{ conversacion.nombreConversacion }}</h2>
            <button id="btnRetarAjedrez" type="button" style="background: #27ae60; color: white; padding: 10px 15px; border: none; border-radius: 5px; cursor: pointer; font-weight: bold;">
                ⚔️ Retar a Ajedrez (Lichess API)
            </button>
        </div>
        <hr>

        <div class="chat-history" id="chatHistory" style="flex: 1; overflow-y: auto; margin-bottom: 15px; padding-right: 5px;">
            {% for mensaje in mensajes %}
                {% set isMeClass = (app.user and mensaje.usuario.idUsuario == app.user.idUsuario) ? "is-me" : "" %}

                <div class="message-group {{ isMeClass }}">
                    <strong class="message-author">
                        {{ mensaje.usuario.nombre }}
                        <span class="message-date">
                            - {{ mensaje.fechaMensaje|date("H:i d/m/Y") }}
                        </span>
                    </strong>
                    <div class="message-text">
                        {{ mensaje.contenido }}
                    </div>
                </div>
            {% else %}
                <p id="noMessages" style="color: #999; text-align: center; margin-top: 50px;">No hay mensajes en esta conversación.</p>
            {% endfor %}
        </div>

        <div class="chat-input-form">
            <form id="chatForm" style="display: flex; gap: 10px;">
                <input
                    type="text"
                    id="messageInput"
                    name="contenido"
                    placeholder="Escribe tu mensaje aquí..."
                    required
                    autocomplete="off"
                    style="flex: 1; padding: 10px; border: 1px solid #ccc; border-radius: 4px;"
                >
                <button type="submit" style="padding: 10px 20px; background: #007bff; color: white; border: none; border-radius: 4px; cursor: pointer;">
                    Enviar
                </button>
            </form>
        </div>
    </div>

</div>

<script>
    // Conectamos directamente a la IP loopback para evitar bloqueos del navegador
    const ws = new WebSocket("ws://127.0.0.1:2346");
    const chat = document.getElementById("chatHistory");

    chat.scrollTop = chat.scrollHeight;

    ws.onopen = () => {
        console.log("¡Conexión del chat establecida con el servidor WebSocket!");
    };

    ws.onmessage = (e) => {
        console.log("Mensaje de chat entrante:", e.data);
        const data = JSON.parse(e.data);

        // Filtro estricto de seguridad de conversación
        if (data.conversationId != "{{ conversacion.idConversacion }}") return;

        document.getElementById("noMessages")?.remove();
        const isMe = data.userId == "{{ app.user ? app.user.idUsuario : 0 }}" ? "is-me" : "";

        let messageContent = data.content;

        if (data.isGameLink) {
            const urlFinal = isMe ? data.urlCreador : data.urlRival;

            messageContent = `
                <div style="background: #ebf5fb; padding: 12px; border-left: 4px solid #3498db; margin-top: 5px; border-radius: 4px;">
                    <p style="margin: 0 0 8px 0; font-weight: bold; color: #2c3e50;">♟️ ¡Reto de Ajedrez Creado!</p>
                    <a href="${urlFinal}" target="_blank" style="display:inline-block; text-decoration:none; background: #27ae60; color: #fff; border: none; padding: 8px 16px; cursor: pointer; border-radius: 4px; font-weight: bold;">
                        ¡Entrar a Jugar! ⚔️
                    </a>
                </div>
            `;
        }

        // Si el servidor no calcula el tiempo, extraemos la hora local del sistema
        const horaFormateada = data.time ? data.time : new Date().toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});

        chat.insertAdjacentHTML("beforeend", `
            <div class="message-group ${isMe}">
                <strong class="message-author">${data.username} <span class="message-date">- ${horaFormateada}</span></strong>
                <div class="message-text">${messageContent}</div>
            </div>
        `);
        chat.scrollTop = chat.scrollHeight;
    };

    document.getElementById("chatForm").addEventListener("submit", (e) => {
        e.preventDefault();
        const input = document.getElementById("messageInput");
        if (!input.value.trim()) return;

        ws.send(JSON.stringify({
            conversationId: "{{ conversacion.idConversacion }}",
            userId: "{{ app.user ? app.user.idUsuario : 0 }}",
            username: "{{ app.user ? app.user.nombre : 'Anónimo' }}",
            content: input.value.trim()
        }));

        input.value = "";
    });

    // LÓGICA DEL RETO INTEGRADO EN EL CHAT
    document.getElementById("btnRetarAjedrez").addEventListener("click", () => {
        fetch("https://lichess.org/api/challenge/open", {
            method: "POST",
            headers: {
                "Content-Type": "application/x-www-form-urlencoded"
            },
            body: new URLSearchParams({
                "clock.limit": "600",
                "clock.increment": "5",
                "variant": "standard"
            })
        })
        .then(response => response.json())
        .then(data => {
            const soyBlancas = Math.random() < 0.5;

            let urlParaMi = "";
            let urlParaRival = "";

            if (soyBlancas) {
                urlParaMi = data.urlWhite;
                urlParaRival = data.urlBlack;
            } else {
                urlParaMi = data.urlBlack;
                urlParaRival = data.urlWhite;
            }

            ws.send(JSON.stringify({
                conversationId: "{{ conversacion.idConversacion }}",
                userId: "{{ app.user ? app.user.idUsuario : 0 }}",
                username: "{{ app.user ? app.user.nombre : 'Anónimo' }}",
                content: "Ha enviado un reto de ajedrez.",
                isGameLink: true,
                urlCreador: urlParaMi,
                urlRival: urlParaRival
            }));
        })
        .catch(err => {
            console.error("Error en la petición:", err);
            alert("Error al conectar con la API de Lichess.");
        });
    });
</script>
{% endblock %}
