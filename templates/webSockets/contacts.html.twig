{% extends "base.html.twig" %}

{% block title %}{% endblock %}

{% block header %}
    <div style="padding: 10px 20px; background: #f4c542; display: flex; gap: 15px; align-items: center;">
        <a href="{{ path("app_home") }}" style="text-decoration: none; color: #333; font-weight: bold;">🏠 Volver al Inicio</a>
        <a href="{{ path("logout") }}" style="text-decoration: none; color: #a93226; font-weight: bold;">🚪 Cerrar Sesión</a>
    </div>
{% endblock %}

{% block content %}

<h1>Mis Contactos</h1>
    <a href="path"><h4>Añadir nuevo contacto</h4></a>
<hr>

<div class="contacts-container">

    <ul class="contacts-list">
        {% for registro in contactos %}
            <li class="contact-item">
                <div class="contact-info">
                    <strong class="contact-name">
                        {{ registro.contacto.nombre }}
                    </strong>
                    <span class="contact-email">
                        ({{ registro.contacto.correo }})
                    </span>
                </div>
            </li>
        {% else %}
            <li class="no-contacts">No tienes contactos agregados todavía.</li>
        {% endfor %}
    </ul>

</div>
{% endblock %}
