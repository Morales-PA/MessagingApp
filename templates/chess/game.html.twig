{% extends 'base.html.twig' %}

{% block header %}
    <a href="/crear-cuenta">Volver al Chat</a>
{% endblock %}

{% block content %}
<div style="text-align: center; padding: 10px;">
    <h2>Partida de Ajedrez Profesional</h2>
    <p style="color: #64748b; font-size: 14px; margin-bottom: 15px;">
        Conectado en tiempo real mediante la API de <strong>Lichess.org</strong>
    </p>

    <div style="width: 100%; max-width: 600px; margin: 0 auto; box-shadow: 0 10px 25px rgba(0,0,0,0.2); border-radius: 8px; overflow: hidden;">
        <iframe
            src="{{ url_partida }}"
            style="width: 100%; height: 550px; border: none;"
            allowtransparency="true">
        </iframe>
    </div>

    <p style="margin-top: 15px; font-size: 13px; color: #94a3b8;">
        Nota: Los movimientos se sincronizan automáticamente gracias al WebSocket de la API externa.
    </p>
</div>
{% endblock %}
